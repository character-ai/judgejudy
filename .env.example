# JudgeJudy Environment Variables
# Copy this file to .env and fill in your API keys.
# Only set the keys for providers you plan to use.

# OpenAI — required for GPT-4o, DALL-E, TTS, Whisper
JUDGEJUDY_OPENAI_API_KEY=sk-...

# Anthropic — required for Claude models
JUDGEJUDY_ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — required for Gemini models
JUDGEJUDY_GOOGLE_API_KEY=AIza...

# Replicate — required for image/video/audio generation models
JUDGEJUDY_REPLICATE_API_KEY=r8_...

# Together AI — required for open-source models (Llama, Mistral, etc.)
JUDGEJUDY_TOGETHER_API_KEY=...

# Ollama — local models, no API key needed
# Set custom host if not running on default port
# JUDGEJUDY_OLLAMA_HOST=http://localhost:11434

# ElevenLabs — required for ElevenLabs TTS
JUDGEJUDY_ELEVENLABS_API_KEY=...

# Cartesia — required for Cartesia TTS
JUDGEJUDY_CARTESIA_API_KEY=...

# fal.ai — required for Kling3 video generation
JUDGEJUDY_FALAI_API_KEY=...

# WaveSpeed — required for image/video generation (Seedance, WAN, VEO3, Sora, etc.)
JUDGEJUDY_WAVESPEED_API_KEY=...

# Optional: Redis for generation caching (speeds up re-runs)
# If not set, caching is disabled and everything works fine without it.
# REDIS_ADDR=localhost:6379
